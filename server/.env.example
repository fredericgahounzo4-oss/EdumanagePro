# Copiez ce fichier vers .env dans ce même dossier (server/.env) pour le développement local.
# En production (Vercel), renseignez ces mêmes variables dans Project Settings → Environment Variables
# — le fichier .env n'est utilisé qu'en local, il n'est jamais déployé (voir .gitignore).

# Chaîne de connexion PostgreSQL — en local, votre base Postgres locale ;
# en production, la connexion "pooled" fournie par Neon.
DATABASE_URL=postgres://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/schoolmanager

# Phrase secrète utilisée pour signer les sessions (JWT). N'importe quelle phrase suffit en local ;
# utilisez une phrase longue et aléatoire en production.
JWT_SECRET=dev-secret-pour-tests-locaux

# Port local uniquement (ignoré sur Vercel)
PORT=4000
