# Copiez ce fichier en .env et adaptez les valeurs (ne jamais committer .env)

DJANGO_SECRET_KEY=change-me-generate-a-real-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend React (Vite) autorisé à appeler l'API (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base de données : SQLite par défaut. Pour PostgreSQL, décommentez et remplissez :
# DB_ENGINE=postgres
# DB_NAME=edumanage
# DB_USER=edumanage
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# Sur Render, définissez DATABASE_URL directement avec la chaîne de
# connexion Neon (mode "Pooled connection", voir le README à la racine du
# dépôt) — cette variable prend le pas sur DB_ENGINE si elle est présente.
