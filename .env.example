# Copiez ce fichier vers .env (local) ou renseignez ces variables dans Vercel
# (Project Settings → Environment Variables) pour le déploiement en production.

# Chaîne de connexion PostgreSQL (Neon : utilisez la connexion "pooled")
DATABASE_URL=postgres://user:password@host/dbname

# Phrase secrète utilisée pour signer les sessions (JWT). Générez-en une longue et aléatoire.
JWT_SECRET=change-me-to-a-long-random-secret

# Port local uniquement (ignoré sur Vercel)
PORT=4000

# Secret de la tâche quotidienne (Vercel Cron) qui ferme et supprime les écoles à l'échéance de leur cycle de vie.
# Générez une longue chaîne aléatoire ; la même valeur doit être définie dans les variables d'environnement Vercel.
CRON_SECRET=
